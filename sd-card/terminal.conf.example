# sen-TapIn terminal configuration TEMPLATE
# Copy this file to the ROOT of the MicroSD card as `terminal.conf`,
# alongside allowlist.txt, then fill in the real values there.
#
# ONLY THIS PLACEHOLDER TEMPLATE LIVES IN THE REPOSITORY. The filled-in
# terminal.conf holds the Wi-Fi password and must never be committed —
# .gitignore blocks sd-card/terminal.conf for exactly that reason.
# Keeping the real file on the card also means one identical firmware
# image runs on every terminal — only the card differs.
#
# Format: key = value, one per line. Lines starting with # are ignored.
# If this file is missing or incomplete the terminal runs normally with
# networking disabled. That is not a fault.

# --- Wi-Fi ---
ssid = YourNetwork
password = YourPassword

# --- Identity ---
# Sent with every check-in so the server log can tell terminals apart.
# Use something you would recognise in a log at 2am: lobby, workshop-rear.
terminal_id = lobby

# --- Check-in ---
# A small static JSON file you publish, e.g.
#   {"rev": 8,
#    "url": "https://example.com/sen-tapin/allowlist.txt",
#    "sha256": "...",
#    "sig": "..."}
#
# Only "rev" is read by this build; the other fields are consumed by the
# roster download stage and are listed here so the format does not change
# under deployed terminals.
#
# https:// is preferred. http:// works, and roster authenticity does not
# depend on the transport — it comes from the Ed25519 signature checked at
# download time. What plain http costs you is confidentiality: the roster
# is a list of real names, so treat that as a deliberate choice, not a
# default.
manifest_url = https://example.com/sen-tapin/manifest.json
